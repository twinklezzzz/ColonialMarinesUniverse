<controls:CMUMarketsTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.CorporateWork"
    Title="{Loc cmu-markets-title}" MinSize="460 520" SetSize="520 640">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Text="{Loc cmu-markets-heading}" StyleClasses="LabelHeading" Margin="0 4" />
        <RichTextLabel Text="{Loc cmu-markets-instructions}" HorizontalExpand="True" Margin="0 2" />
        <Label Name="BudgetLabel" Access="Public" Text="" Margin="0 4 0 0" />
        <Label Name="HoldingsLabel" Access="Public" Text="" />
        <Label Name="TickLabel" Access="Public" Text="" StyleClasses="LabelSubText" />

        <Label Text="{Loc cmu-markets-board}" Margin="0 6 0 2" />
        <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="QuoteRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0 4">
            <LineEdit Name="UnitsInput" Access="Public" Text="1" PlaceHolder="{Loc cmu-markets-units}" HorizontalExpand="True" />
            <Button Name="BuyButton" Access="Public" Text="{Loc cmu-markets-buy}" HorizontalExpand="True" />
            <Button Name="SellButton" Access="Public" Text="{Loc cmu-markets-sell}" HorizontalExpand="True" />
        </BoxContainer>

        <Label Text="{Loc cmu-markets-news}" Margin="0 6 0 2" />
        <BoxContainer Name="NewsRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" MinHeight="120" />
    </BoxContainer>
</controls:CMUMarketsTerminalWindow>
