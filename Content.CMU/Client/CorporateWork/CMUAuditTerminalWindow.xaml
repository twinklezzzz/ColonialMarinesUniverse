<controls:CMUAuditTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.CorporateWork"
    Title="{Loc cmu-audit-title}" MinSize="640 520">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Text="{Loc cmu-audit-heading}" StyleClasses="LabelHeading" Margin="0 4" />
        <Label Text="{Loc cmu-audit-instructions}" StyleClasses="LabelSubText" Margin="0 2" />

        <!-- Case selection -->
        <Label Text="{Loc cmu-audit-tiers-section}" Margin="0 6 0 2" />
        <BoxContainer Name="TierButtons" Access="Public" Orientation="Horizontal" SeparationOverride="4" Margin="0 2" />
        <Label Name="StatusLabel" Access="Public" Text="" Margin="0 4" />

        <!-- Ledger and report side by side -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8" Margin="0 4">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <Label Text="{Loc cmu-audit-ledger}" Margin="0 2" />
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Name="LedgerRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <Label Text="{Loc cmu-audit-report}" Margin="0 2" />
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Name="ReportRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>

        <Button Name="SubmitButton" Access="Public" Text="{Loc cmu-audit-submit}" HorizontalExpand="True" Margin="0 4" />
    </BoxContainer>
</controls:CMUAuditTerminalWindow>
