<controls:CMUTransmissionsTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.CorporateWork"
    Title="{Loc cmu-transmissions-title}" MinSize="420 480" SetSize="460 560">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Text="{Loc cmu-transmissions-heading}" StyleClasses="LabelHeading" Margin="0 4" />
        <RichTextLabel Text="{Loc cmu-transmissions-instructions}" HorizontalExpand="True" Margin="0 2" />

        <Label Text="{Loc cmu-transmissions-tiers-section}" Margin="0 6 0 2" />
        <BoxContainer Name="TierButtons" Access="Public" Orientation="Vertical" SeparationOverride="4" Margin="0 2" />
        <Label Name="StatusLabel" Access="Public" Text="" Margin="0 4" />

        <Label Text="{Loc cmu-transmissions-log}" Margin="0 2" />
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="AttemptRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>

        <Label Name="InputLabel" Access="Public" Text="" StyleClasses="LabelHeading" Margin="0 4" />
        <BoxContainer Name="SymbolButtons" Access="Public" Orientation="Horizontal" SeparationOverride="4" Margin="0 2" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0 4">
            <Button Name="ClearButton" Access="Public" Text="{Loc cmu-transmissions-clear}" HorizontalExpand="True" />
            <Button Name="SubmitButton" Access="Public" Text="{Loc cmu-transmissions-submit}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:CMUTransmissionsTerminalWindow>
