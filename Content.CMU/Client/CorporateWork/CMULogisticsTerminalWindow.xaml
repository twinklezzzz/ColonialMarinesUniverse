<controls:CMULogisticsTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.CorporateWork"
    Title="{Loc cmu-logistics-title}" MinSize="440 460" SetSize="480 540">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Text="{Loc cmu-logistics-heading}" StyleClasses="LabelHeading" Margin="0 4" />
        <RichTextLabel Text="{Loc cmu-logistics-instructions}" HorizontalExpand="True" Margin="0 2" />

        <Label Text="{Loc cmu-logistics-tiers-section}" Margin="0 6 0 2" />
        <BoxContainer Name="TierButtons" Access="Public" Orientation="Vertical" SeparationOverride="4" Margin="0 2" />
        <Label Name="StatusLabel" Access="Public" Text="" Margin="0 4" />

        <Label Text="{Loc cmu-logistics-manifest}" Margin="0 2" />
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="CrateRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>

        <Label Name="TotalsLabel" Access="Public" Text="" Margin="0 4" />
        <Button Name="SubmitButton" Access="Public" Text="{Loc cmu-logistics-submit}" HorizontalExpand="True" Margin="0 4" />
    </BoxContainer>
</controls:CMULogisticsTerminalWindow>
