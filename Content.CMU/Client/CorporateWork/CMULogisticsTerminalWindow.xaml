<controls:CMULogisticsTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.CorporateWork"
    Title="{Loc cmu-logistics-title}" MinSize="720 520" SetSize="860 620">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="12" Margin="12">
        <!-- Brief, cases and status -->
        <BoxContainer Orientation="Vertical" SetWidth="270" MinWidth="270" VerticalExpand="True" SeparationOverride="8">
            <Label Text="{Loc cmu-logistics-heading}" StyleClasses="LabelHeading" />
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <RichTextLabel Text="{Loc cmu-logistics-instructions}" HorizontalExpand="True" />
            </ScrollContainer>
            <Label Text="{Loc cmu-logistics-tiers-section}" />
            <BoxContainer Name="TierButtons" Access="Public" Orientation="Vertical" SeparationOverride="6" />
            <RichTextLabel Name="StatusLabel" Access="Public" HorizontalExpand="True" Margin="0 4 0 0" />
        </BoxContainer>

        <!-- The work itself -->
        <PanelContainer Name="WorkPanel" Access="Public" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8">
                <Label Text="{Loc cmu-logistics-manifest}" />
                <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Name="CrateRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
                </ScrollContainer>
                <Label Name="TotalsLabel" Access="Public" HorizontalExpand="True" />
                <Button Name="SubmitButton" Access="Public" Text="{Loc cmu-logistics-submit}" HorizontalExpand="True" MinHeight="36" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:CMULogisticsTerminalWindow>
